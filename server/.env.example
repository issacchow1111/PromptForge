PORT=3000

# Upstream LLM configuration used when proxying requests
PROXY_BASE_URL=https://api.openai.com/v1
PROXY_API_KEY=sk-xxxxxxxx
PROXY_MODEL=gpt-4o-mini

# CORS origin allowed in production (dev is usually allowed by cors package when unset)
CORS_ORIGIN=http://localhost:5173

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=10

# Request body size limit in KB
MAX_BODY_SIZE_KB=100
